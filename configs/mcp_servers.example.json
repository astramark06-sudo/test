{
  "mcpServers": {
    "filesystem": {"enabled": false, "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "./data", "./artifacts", "./configs"], "risk": "high", "notes": "Only expose project directories."},
    "fetch": {"enabled": false, "command": "uvx", "args": ["mcp-server-fetch"], "risk": "medium", "notes": "Fetch public pages; do not enable private IP access."},
    "playwright": {"enabled": false, "command": "npx", "args": ["-y", "@playwright/mcp@latest", "--headless"], "risk": "high", "notes": "Use an isolated browser profile."},
    "memory": {"enabled": false, "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory"], "risk": "medium"},
    "git": {"enabled": false, "command": "uvx", "args": ["mcp-server-git", "--repository", "./"], "risk": "high"},
    "github": {"enabled": false, "command": "docker", "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"], "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"}, "risk": "high", "notes": "Prefer connected GitHub App integration; least-privilege credentials."}
  }
}
